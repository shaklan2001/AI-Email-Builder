# AI Email Workflow Builder — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=email-workflow-builder
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Frontend (copy to frontend/.env.local)
# VITE_API_URL=http://localhost:8000
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=email_workflow_builder

# ------------------------------------------------------------------------------
# Redis + Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# Clerk (Auth)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
# PEM public key for JWT verification (from Clerk dashboard)
CLERK_PEM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ------------------------------------------------------------------------------
# LLM (Groq) — via provider abstraction
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# LangSmith (optional but recommended for agent tracing)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_
LANGCHAIN_PROJECT=email-workflow-builder
LANGSMITH_API_KEY=lsv2_pt_

# ------------------------------------------------------------------------------
# Email (Resend) — via provider abstraction
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=whsec_

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Used for any app-signed tokens (if needed beyond Clerk)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Feature flags (MVP)
# ------------------------------------------------------------------------------
ENABLE_LANGSMITH_TRACING=true
ENABLE_WEBHOOK_SIGNATURE_VERIFY=true
